{
  "name": "wikipedia-path-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run",
    "build:graph": "tsx scripts/build-graph.ts",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test:local": "npm run build:graph -- --lang en --page tests/fixtures/page.sql --pagelinks tests/fixtures/pagelinks.sql --linktarget tests/fixtures/linktarget.sql --redirect tests/fixtures/redirect.sql --out public/graphs/en.bin.gz && VITE_LINK_SOURCE=local VITE_BASE_PATH=/ vite build --config vite.config.ts --outDir dist-local && playwright test --config playwright.local.config.ts",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "benchmark:search": "tsx scripts/benchmark-search.ts"
  },
  "dependencies": {
    "linkedom": "^0.18.13",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.5",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "sharp": "^0.34.5"
  }
}
