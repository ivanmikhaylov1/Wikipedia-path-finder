{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "target": "ES2022",
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "scripts/*.ts",
    "src/lib/graphFormat.ts",
    "src/lib/**/*.ts",
    "src/vite-env.d.ts",
    "tests/fixtures/apiBenchmark.ts"
  ]
}
